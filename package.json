    "daisyui": "^5.5.20",
    "knip": "^6.14.2",
    "lefthook": "^2.1.8",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.8",
    "typescript": "~6.0.3",
    "vite": "^8.0.14"
  },
